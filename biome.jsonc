{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "files": {
    "includes": ["**/*.mjs", "**/*.ts"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "performance": {
        "noDelete": "error"
      },
      "style": {
        "useConst": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "noParameterAssign": "error",
        "noNonNullAssertion": "error",
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": {
            "maxLines": 350
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConfusingVoidType": "error",
        "noAsyncPromiseExecutor": "error",
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", ".claude/skills/**/*.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/test/**/*.mjs", "**/test/**/*.ts", "**/*.test.mjs", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          },
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      // The shared lint config, whose whole content is written justification for
      // rules held off. Line count is the one metric that runs backwards here:
      // more lines means more reasons recorded, and a cap the file sits flush
      // against turns "write down why" into "find four lines to cut". That trade
      // was nearly made twice tonight — once at 354, where a header paragraph
      // was dropped to fit, and once at 353. Neither should have been a choice.
      "includes": ["eslint.config.mjs"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    },
    {
      // Four files in trove-matt-helm that are data, not code. Present here so the
      // two catalogs' biome configs stay byte-identical; inert in this one.
      //
      // Responses captured verbatim from api.charitydata.ca and dated — a recorded
      // session is one artifact, and split by line count no copy still matches what
      // the API sent.
      "includes": ["mcp/charitydata/fixtures.ts"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    },
    {
      // The T3010 line-number dictionary, transcribed from the CRA. Split a published
      // table across files and a reader can no longer check it against its source —
      // the same reason sha256.ts is excused from numeric-separators-style.
      "includes": ["mcp/charitydata/lines.ts"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    },
    {
      // Thirty-nine interfaces and no functions: one wire vocabulary for an
      // undocumented API. Halving it by length separates related shapes for no
      // reason a reader could reconstruct.
      "includes": ["mcp/charitydata/types.ts"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    },
    {
      // Every operation AXSMarine documents, with spec.test.mjs asserting full
      // coverage against it. The file being one thing is what the test relies on.
      "includes": ["mcp/axsmarine/catalogue.ts"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    }
  ]
}
