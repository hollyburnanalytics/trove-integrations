# Dependencies. No trailing slash, deliberately: `node_modules/` matches a
# directory only, so a *symlink* named node_modules is untracked-but-not-ignored
# and any `git add -A` commits it. That has happened once — a self-referential
# symlink reached main, and checking it out replaced the real directory.
node_modules

# Lockfiles — these projects use bun; keep only bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
coverage/

# mise local state
.mise/

# Internal authoring aids — not part of the published catalog.
.claude/

# Private, local-only working rules for AI assistants (never commit)
CLAUDE.local.md

# Local working notes, not part of either catalog
/NOTES.local.md
/OPEN-SOURCE-READINESS.md
