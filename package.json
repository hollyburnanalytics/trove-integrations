{
  "name": "trove-integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Hollyburn Analytics Inc.",
  "description": "Toolkits and sources that connect Trove (and AI agents) to the outside world.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hollyburnanalytics/trove-integrations.git"
  },
  "packageManager": "bun@1.3.2",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "bun run typecheck:mcp && bun run typecheck:sources",
    "typecheck:mcp": "tsc --noEmit -p mcp/tsconfig.json",
    "typecheck:sources": "tsc -p tsconfig.sources.json",
    "source": "bun bin/run-source.mjs",
    "audit:dates": "bun scripts/audit-dates.mjs",
    "check": "bun run lint && bun run lint:sonar && bun run lint:baseline && bun run test:coverage && bun run typecheck && bun run validate && bun run validate:schemas",
    "validate": "bun scripts/validate-registry.mjs",
    "lint:sonar": "eslint .",
    "lint:baseline": "node scripts/lint-baseline.mjs",
    "validate:schemas": "bun scripts/orphan-fields.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "node-html-parser": "^8.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@ontrove/mcp": "^0.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "bun-types": "^1.3.14",
    "eslint": "^10.1.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10",
    "zod": "^4"
  }
}
